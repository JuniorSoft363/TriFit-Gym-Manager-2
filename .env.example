# Variables de entorno para docker compose.
# Copia este archivo a .env y ajusta los valores antes de levantar los servicios.
# Nunca subas el .env al repositorio.

POSTGRES_USER=postgres
# En producción usa una contraseña fuerte: openssl rand -base64 32
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trifit

# Secreto para firmar los JWT. Si se deja vacío o con valor de ejemplo,
# el backend genera uno aleatorio y lo persiste en el volumen backend_data.
# Para generarlo manualmente: openssl rand -base64 48
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES=8h

# Orígenes permitidos por CORS (coma-separados). En producción, el dominio real.
CORS_ORIGIN=https://localhost:8443,http://localhost:4200

# Respaldos: retención en días e intervalo en segundos (defecto 14 días / 24 h).
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Puerto HTTPS visto desde el host (8443 en desarrollo, 443 en producción).
HTTPS_PORT=8443
